{
  "name": "sonora",
  "productName": "Sonora",
  "description": "SoundCloud Hi-Fi Music Player with MildWave Radio",
  "version": "1.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "electron:pack": "tsc -b && vite build && electron-builder --win --dir",
    "electron:build": "tsc -b && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.sonora.player",
    "productName": "Sonora",
    "compression": "store",
    "npmRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/sonora-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
